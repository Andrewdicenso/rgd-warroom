data/db/*.db
data/logs/*

# --- UPLOAD DINAMICI (mantiene la cartella con .gitkeep) ---
data/uploads/*
!data/uploads/.gitkeep

# --- CONFIGURAZIONI IDE ---
.vscode/
.idea/
*.swp
*.swo