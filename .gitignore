# --- AMBIENTI VIRTUALI PYTHON ---
venv/
env/
ENV/

# --- CACHE DI PYTHON ---
__pycache__/
*/__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# --- CREDENZIALI E SICUREZZA (CRITICO) ---
