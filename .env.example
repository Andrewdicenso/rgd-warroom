# ==========================================
# RGD-Alpha Environment Variables Template
# ==========================================
# Copia questo file a .env e configura i valori

# ========== APP ==========
ENVIRONMENT=development
DEBUG=true

# ========== ADMIN CREDENTIALS ==========
ADMIN_EMAIL=andrewdicenso@libero.it
# Password è hardcoded come: WarRoom123!

# ========== DATABASE ==========
DATABASE_URL=sqlite:///data/db/azienda.db
VAULT_KEY_PATH=core/security/vault.key

# ========== SECURITY ==========
JWT_SECRET=your-super-secret-key-change-in-production
BCRYPT_ROUNDS=12

# ========== EMAIL (SMTP) ==========
SMTP_SERVER=smtp.libero.it
SMTP_PORT=465
SMTP_USER=your-email@libero.it
SMTP_PASSWORD=your-app-password

# ========== GOOGLE API (Gmail) ==========
GMAIL_CLIENT_ID=your-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-client-secret
GMAIL_REFRESH_TOKEN=your-refresh-token

# ========== GROQ API (LLM) ==========
GROQ_API_KEY=your-groq-api-key

# ========== LOGGING ==========
LOG_LEVEL=INFO
